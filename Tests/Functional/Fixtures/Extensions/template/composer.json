{
	"name": "sudhaus7/template",
	"description": "config for the wizard for the sitepackage template",
	"type": "typo3-cms-extension",
	"license": "MIT",
	"config": {
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true,
			"php-http/discovery": true
		}
	},
	"require": {
		"georgringer/news": "^12.0 || ^14.1"
	},
	"autoload": {
		"psr-4": {
			"SUDHAUS7\\Sudhaus7Template\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "template",
			"version": "1.0.0",
			"Package": {
				"providesPackages": []
			}
		}
	}
}
